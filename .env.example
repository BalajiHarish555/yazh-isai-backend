# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (PostgreSQL everywhere — local dev uses the bundled
# pgserver instance, cloud uses Render/Neon Postgres).
# Local: run `npm run db:start` once per boot — it starts Postgres and writes
# the correct DATABASE_URL into your `.env` automatically (trust auth, dev
# machine only).
# Cloud:  DATABASE_URL="postgresql://user:password@host:5432/yzh_music?schema=public"

# Security & Authentication
# JWT_SECRET MUST BE AT LEAST 32 CHARACTERS LONG IN PRODUCTION
JWT_SECRET="replace_with_a_super_strong_random_secret_key_at_least_32_chars"

# Allowed CORS Origins (comma separated)
CORS_ORIGIN="http://localhost:5173,https://your-production-app.com"

# Optional: Deezer lossless (FLAC) playback.
# Leave unset to disable the FLAC lane entirely (Saavn/YouTube still work).
# To enable: log in to deezer.com in a browser, open DevTools > Application >
# Cookies > https://www.deezer.com, and copy the value of the `arl` cookie
# (a ~192-char hex string). Set it here (or in Render's Environment tab).
# NEVER commit a real ARL — this file is an example only.
# DEEZER_ARL=

# Optional: Tidal FLAC playback (two parts).
# 1. Client ID + secret identify the app (metadata + login). NEVER commit
#    real credentials — this file is an example only.
# 2. Audio itself needs YOUR login: GET /tidal/login, open the loginUrl in a
#    browser (HiFi-tier account for lossless), then POST the final browser
#    URL to /tidal/callback. Tokens persist in .tidal-tokens.json (gitignored).
# TIDAL_CLIENT_ID=
# TIDAL_CLIENT_SECRET=
# TIDAL_REDIRECT_URI=https://tidal.com/android/login/auth

# Optional: Deezer fallback settings.
# Enable Deezer fallback when primary services fail.
# DEEZER_FALLBACK_ENABLED=true
# DEEZER_FALLBACK_API_BASE_URL=https://dzr.tabs-vs-spaces.wtf

# Podcast API credentials.
# Get these from ListenNotes or similar podcast API provider.
# PODCAST_API_KEY=
# PODCAST_API_SECRET=
