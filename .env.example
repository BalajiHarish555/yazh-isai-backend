# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (PostgreSQL everywhere — local dev uses the bundled
# pgserver instance, cloud uses Render/Neon Postgres).
# Local: run `npm run db:start` once per boot — it starts Postgres and writes
# the correct DATABASE_URL into your `.env` automatically (trust auth, dev
# machine only).
# Cloud:  DATABASE_URL="postgresql://user:password@host:5432/yzh_music?schema=public"

# Security & Authentication
# JWT_SECRET MUST BE AT LEAST 32 CHARACTERS LONG IN PRODUCTION
JWT_SECRET="replace_with_a_super_strong_random_secret_key_at_least_32_chars"

# Allowed CORS Origins (comma separated)
CORS_ORIGIN="http://localhost:5173,https://your-production-app.com"
